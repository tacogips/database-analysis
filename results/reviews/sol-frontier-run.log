  \"bench\/requested\/01c-ACCURACY-COST.versions\",\n        \"bench\/requested\/01d-ACCURACY-SERVICE-100.versions\",\n        \"bench\/requested\/01c-ACCURACY-COST.encrypted\",\n        \"bench\/requested\/01d-ACCURACY-SERVICE-100.encrypted\",\n        \"bench\/samplinglib.py\",\n        \"bench\/sampling_bounds.py\",\n        \"bench\/reqwide.py\",\n        \"bench\/lablib.py\",\n        \"bench\/reqlib.py\",\n        \"bench\/dependencies.py\",\n        \"lab.rb\",\n        \"compose.yaml\",\n        \"docs\/table-count-guideline.md\",\n        \"docs\/probability-count.md\",\n        \"results\/reviews\/accuracy-frontier-design-check.json\",\n        \"results\/reviews\/accuracy-frontier-existing-evidence.json\"\n      ],\n      \"revisionBoundary\": \"指摘の行番号は上記スナップショット基準。results\/reviews\/full-review-input.jsonと検索で表示された現行ファイルは背景情報としてのみ使用し、後日の編集で指摘を解消済みとは扱っていない。\",\n      \"operations\": \"ファイル読み取り、ハッシュ、AST解析、DBを使わない算術のみ。DB接続・Docker操作・負荷生成・実験実行・編集・別ワークフロー・委任は行っていない。\"\n    },\n    \"findings\": [\n      {\n        \"id\": \"SOL-FRONTIER-001\",\n        \"severity\": \"middle\",\n        \"section\": \"01c：失敗結果の永続化\",\n        \"scenario\": \"sample_then_countのアームで標本接続が切れ、sampleがquery_failedまたはcleanup_failedを返す。その後、同じ接続で比較COUNTを実行すると再び例外になる。\",\n        \"evidence\": [\n          \"bench\/accuracy_frontier.py:109でsampleの結果を受け取る。\",\n          \"同:114で比較COUNTを実行した後、116〜117で初めて標本結果をappend・保存する。\",\n          \"bench\/samplinglib.py:96〜104は問い合わせエラーとROLLBACKエラーを結果に格納して返す。\",\n          \"unexpected_failuresの構築はbench\/accuracy_frontier.py:122〜124のループ完了後だけ。\"\n        ],\n        \"impact\": \"元の標本エラー・精度状態・予算状態・後始末状態がJSONに残らず、ログには後続COUNTの例外だけが残り得る。complete=falseと非ゼロ終了により誤合格は防げるが、何が失敗したかの根拠と後続条件の観測を失う。\",\n        \"requiredCorrection\": \"標本結果を比較COUNTより先に識別情報付きで保存する。比較COUNTの失敗も別フィールドへ記録する。壊れた接続は再利用せず、終了確認後に再接続するか、継続不能として明示的に中止する。安全が確認できない状態で全アームの継続を要求するものではない。\"\n      },\n      {\n        \"id\": \"SOL-FRONTIER-002\",\n        \"severity\": \"middle\",\n        \"section\": \"01d：意図した問い合わせ上限と後続アーム\",\n        \"scenario\": \"最初のrepeatではsample3がsample10より先に動く。sample3の範囲COUNTが設定済み100ms上限に達して3024を返すと、sample10まで到達しない。\",\n        \"evidence\": [\n          \"bench\/samplinglib.py:44で各問い合わせにmax_execution_time=100を設定する。\",\n          \"同:96〜97は3024を含むMySQLErrorを一律query_failedにする。\",\n          \"bench\/accuracy_frontier.py:30はquery_failedをUNEXPECTEDに含める。\",\n          \"同:168〜178はcontrol\/count\/sample3\/sample10の順から始まり、query_failedを保存した直後に実験全体を中止する。\",\n          \"対照的にbench\/reqwide.py:70〜72のexact COUNTは1317・3024を記録して後続処理へ進む。\"\n        ],\n        \"impact\": \"比較したい『厳しい目標は予算内に完了しないが、緩い目標なら完了するか』という条件で、設定した問い合わせ上限への到達が後続の10%測定を止め得る。全体1秒のbudget_exhaustedは保持できているが、文単位の上限到達は同じ扱いになっていない。\",\n        \"requiredCorrection\": \"設定した文上限による中断を、構文・権限・接続などの予期しない障害から区別する。errnoと文予算到達を残し、終了・ROLLBACKを確認できた場合は後続アームへ進める。全体1秒を使い切ったと偽って分類せず、文予算と全体予算を分ける。原因不明の1317まで自動的に正常な予算到達へ変換しない。\"\n      },\n      {\n        \"id\": \"SOL-FRONTIER-003\",\n        \"severity\": \"middle\",\n        \"section\": \"実験完了と検証環境の後始末\",\n        \"scenario\": \"01dが48アームを完了した後、matrixコンテナの削除が失敗する。実験プロセス自体はexit 0で終了している。\",\n        \"evidence\": [\n          \"bench\/accuracy_frontier.py:180〜184はcomplete=trueを保存し、接続を閉じる。サービス用fixtureの撤去はrunner側に依存する。\",\n          \"lab.rb:181〜184は削除コマンドのremovedを受け取るが、失敗を上位へ伝播せず、撤去結果も成果物へ保存しない。\",\n          \"lab.rb:115のok条件は実験終了、必須出力、入力ハッシュ一致であり、撤去成功を含まない。\",\n          \"lab.rb:123〜129の既存データ検証は、当該matrixコンテナの撤去確認にはならない。\"\n        ],\n        \"impact\": \"実験完了と後始末完了を別に判定できず、検証用DBが残存してもrunnerが成功を報告し得る。01cのfixture_cleanupは有用だが、01dとrunner所有資源には同等の証拠がない。\",\n        \"requiredCorrection\": \"runnerが所有するコンテナ・データ領域の撤去結果を、実験結果とは別の状態として記録する。撤去失敗または確認不能なら実行全体を成功扱いしない。01d側で重複したDROPを増やす必要はなく、所有者であるrunnerの終了処理で確認する。\"\n      },\n      {\n        \"id\": \"SOL-FRONTIER-004\",\n        \"severity\": \"low\",\n        \"section\": \"サービス観測の未計測値\",\n        \"scenario\": \"ロック観測を無効にしたサービスアームでも、集計JSONには行ロック・テーブルロックのピークが0として出る。\",\n        \"evidence\": [\n          \"bench\/reqwide.py:51はSamplerをdata_locks=Falseで作る。\",\n          \"bench\/lablib.py:223〜226はこの場合row_locks_seenとtable_is_locksを収集しない。\",\n          \"同:257、274〜275は未収集キーを0として集計する。\"\n        ],\n        \"impact\": \"未計測が『観測して0だった』と読める。通常のSELECT COUNTが行ロックを取らないという説明自体とは別に、このJSONをその実測証拠にはできない。\",\n        \"requiredCorrection\": \"無効な観測はnullまたはnot_measuredとし、観測機能の有効状態を結果へ保存する。既存互換性のため0を残す場合も、測定値として集計・引用しない明確な状態を付ける。\"\n      }\n    ],\n    \"engineerQuestions\": [\n      {\n        \"question\": \"必要なのは、今回の参考値がおよそ10%以内という期待か、規定した信頼度付きの相対誤差境界か。\",\n        \"reason\": \"メタ情報と信頼区間付き標本では得られる保証が異なる。固定した合成表での成功割合を任意の本番表の成功確率には変換できない。\"\n      },\n      {\n        \"question\": \"許容する取得時点と、複数表・再実行を含めた保証範囲はどこまでか。\",\n        \"reason\": \"各呼び出しのfamily_alpha=.05は全サービス・全試行を合わせた95%保証ではない。レプリカやカウンタでは推定誤差と鮮度差も分ける必要がある。\"\n      },\n      {\n        \"question\": \"既存の小さい索引と、その索引列への更新頻度はどうなっているか。\",\n        \"reason\": \"保持した100列の静的観測では小索引上の正確COUNTが標本を大幅に上回る。一方、サービス負荷中の索引更新条件では正確COUNTにも中断があり、静的順位だけでは決められない。\"\n      },\n      {\n        \"question\": \"単一整数主キーに適用できない表や、既存の信頼できるカウンタを持つ表の経路は用意できるか。\",\n        \"reason\": \"セル標本は任意の未知表に適用できる方式ではなく、適用外を失敗や0件へ置き換えてはいけない。\"\n      }\n    ],\n    \"betterAlternatives\": [\n      {\n        \"method\": \"既存の小さい索引を使う正確COUNT\",\n        \"condition\": \"索引が小さく、同時更新・MVCC・利用可能資源の条件で予算を満たす場合。\",\n        \"evidence\": \"保持した01bの静的比較では小索引ありCOUNTが0.0494〜0.0723秒、標本が1.1712〜3.1946秒。\",\n        \"limits\": \"環境依存の比較。索引追加には構築・保管・更新費用があり、サービス負荷中の安全性をこの静的結果から認定しない。\"\n      },\n      {\n        \"method\": \"既存メタ情報を参考値として利用\",\n        \"condition\": \"保証付き誤差境界を要求せず、まず規模を知りたい場合。\",\n        \"evidence\": \"保存された後期58表の比較ではexpiry=0のTABLE_ROWSがANALYZE前57\/58、後55\/58で実現誤差10%以内だった。\",\n        \"limits\": \"この合成表集合の観測であり、普遍的な10%保証ではない。未初期化・取得不可・統計の古さを明示し、初手にANALYZEを加えない。\"\n      },\n      {\n        \"method\": \"許容誤差内に入った全プロトコルから費用の低いものを選ぶ\",\n        \"condition\": \"10%を許容する場合でも、3%用・5%用・10%用をすべて候補として比較する。\",\n        \"evidence\": \"純計算の可能な標本列では、セル件数188\/192が半々のとき5%用は320抽出で境界約4.87%へ達するが、10%用は160抽出で約10.13%となり次の640抽出まで進む。\",\n        \"limits\": \"抽出数の例であり時間の測定ではない。目標別スケジュールの比較は有用だが、『緩い目標ほど必ず安い』や数学的最適方式という主張はできない。完全な最適化探索は要求しない。\"\n      },\n      {\n        \"method\": \"既存カウンタ・CDC、または余力のある隔離先でのCOUNT\",\n        \"condition\": \"頻繁な取得、またはprimaryで走査する余力がなく、必要な鮮度を満たせる場合。\",\n        \"limits\": \"カウンタには整合した初期件数、削除・再試行・移行の追跡が必要。隔離先には復元・鍵・容量・運用責任があり、レプリカの正確値とprimary現在値は同一ではない。これらの費用は今回未計測。\"\n      }\n    ],\n    \"requestedExperiments\": [\n      {\n        \"id\": \"SOL-FRONTIER-EXP-01\",\n        \"protocol\": \"修正後の既存01c-ACCURACY-COST\",\n        \"scope\": \"7 fixture×5 seed×3目標の105標本結果と対応する実COUNT。\",\n        \"decisionItCanChange\": \"密度偏り・中程度欠番で、3%から5%または10%へ緩めることで全件COUNTより有利になるか。細い表・極端な疎領域でCOUNTを選ぶべきか。\",\n        \"requiredEvidence\": \"挿入実績と初回COUNTの一致、各目標の達成境界・実現誤差・真値被覆、失敗を含む時間と読取量、順序、後始末、終了コード、完結ログ、依存ソースと成果物のハッシュ。\",\n        \"restriction\": \"既存所有者の終了後にCompose検証環境だけで実施する。本査読では実行していない。\"\n      },\n      {\n        \"id\": \"SOL-FRONTIER-EXP-02\",\n        \"protocol\": \"修正後の既存01d-ACCURACY-SERVICE-100\",\n        \"scope\": \"control\/exact\/3%\/10%×索引有無×更新2種類×3反復の48アーム。\",\n        \"decisionItCanChange\": \"既存3%で予算未達だった100列表で、10%の少ない抽出が精度判定と1秒予算を両立するか。小索引や索引更新でCOUNTとの選択が変わるか。\",\n        \"requiredEvidence\": \"文単位と全体の予算到達を残し、actual_method_serviceと3秒trialを分ける。予定到着数の保存則、打切り、エラー、回復、監視失敗と後始末も保持する。\",\n        \"restriction\": \"5%サービス影響は未計測のままでよい。短窓の改善をSLO合格や本番無影響と呼ばない。今回の目的のために50列・全版・全分布のサービス直積を追加する必要はない。\"\n      }\n    ],\n    \"rolloutRecommendation\": {\n      \"designReadiness\": \"SOL-FRONTIER-001〜003を修正して再確認するまで差し戻し。\",\n      \"rolloutReadiness\": \"保留。設計が受理されても本番導入承認にはならない。\",\n      \"remainingGates\": [\n        \"修正版01c\/01dの実測と、期待した精度未達・予算到達を含む結果の統合。\",\n        \"最終コードによる白紙DBからのmise run allと、数値終了コード・完結ログ・意味上の結果・後始末の確認。\",\n        \"固定した最終成果物について、執筆とは別セッションで行う最終2段階Solレビュー。\"\n      ],\n      \"currentGuidance\": \"参考統計、条件付きの確率推定、読み取りビューの正確COUNTを分ける。通常のSELECT COUNT(*)は行ロックを取らないがMDLと資源負荷があり、INSERT ... SELECT COUNT(*)等は読み取り元をロックする場合があるという区別を維持する。\"\n    },\n    \"reviewEvidence\": [\n      {\n        \"phase\": \"開始時ハッシュ検証\",\n        \"files\": 21,\n        \"mismatches\": [],\n        \"guidelineSha256\": \"29c9382c22d1f25f436176c112195280aa1d882383d1e8be234dc96c93995387\",\n        \"exitCode\": 0,\n        \"foregroundOutputReference\": \"efc351\",\n        \"completeLogPath\": null,\n        \"logNote\": \"完結した標準出力はツール記録に保持。READ ONLYのため新規ログファイルは作成していない。\"\n      },\n      {\n        \"phase\": \"静的解析・純計算\",\n        \"checks\": [\n          \"スナップショットのPython 9ファイルをAST解析。\",\n          \"01c\/01dの静的依存閉包を計算し、reqwide・samplinglib・sampling_bounds・lablib・reqlibを含むことを確認。\",\n          \"実装された境界式で、ゼロ分散の各初回lookが目標へ到達可能であることを確認。\",\n          \"3-lookのalpha支出合計0.0375、4-lookの合計0.04で、いずれも宣言値0.05以下と確認。\",\n          \"巨大な疎領域で全標本0でも下端0・相対境界なしとなり、精度達成にならない例を確認。\",\n          \"5%用が10%用より少ない抽出で停止し得るスケジュール例を確認。\"\n        ],\n        \"exitCode\": 0,\n        \"foregroundOutputReferences\": [\n          \"055c16\",\n          \"2580cb\",\n          \"6cb0ec\"\n        ],\n        \"completeLogPath\": null,\n        \"meaning\": \"構文・依存関係・算術の確認。DB測定、被覆確率の実証、サービス合格の証拠ではない。\"\n      },\n      {\n        \"phase\": \"保存済み観測の照合\",\n        \"snapshotRoot\": \"results\/reference\/20261107-wide-sampling\",\n        \"verifiedManifestFiles\": 24,\n        \"mismatches\": [],\n        \"semanticRead\": [\n          \"manifest.json\",\n          \"results\/requested_probability_wide_100.jsonのstatic・service・完了状態\",\n          \"results\/requested\/01b-PROB-WIDE-100.status.json\",\n          \"01a\/01bのログ末尾\"\n        ],\n        \"historicalRunExitCode\": 0,\n        \"completeLogPath\": \"results\/reference\/20261107-wide-sampling\/results\/requested\/01b-PROB-WIDE-100.log\",\n        \"completeLogSha256\": \"29658fddc8140172ed54086bc92a53b3e26fed63c2785c22b917d12bb7736bc2\",\n        \"observations\": \"100列の36サービスアームの到着保存則は全件consistent=true。3%標本は小索引なし6\/6、小索引あり3\/6でbudget_exhausted。新しい48アームの結果ではない。\",\n        \"verificationCommandExitCode\": 0,\n        \"foregroundOutputReferences\": [\n          \"886aea\",\n          \"7e37fe\"\n        ]\n      },\n      {\n        \"phase\": \"過去観測からの派生資料\",\n        \"path\": \"results\/reference\/20261107-frontier-design\/results\/reviews\/accuracy-frontier-existing-evidence.json\",\n        \"sourceHashChecks\": \"指定されたmetadata_accuracyとfixed-samplingの原本2ファイルは、記載SHA-256と一致。\",\n        \"exitCode\": 0,\n        \"foregroundOutputReference\": \"7e37fe\",\n        \"completeLogPath\": null,\n        \"meaning\": \"過去観測と新規実験を区別した。過去のcheckpoint再生から未観測の停止時間を推定していない。\"\n      },\n      {\n        \"phase\": \"検証コマンドの不成立\",\n        \"items\": [\n          {\n            \"foregroundOutputReference\": \"b07873\",\n            \"exitCode\": 1,\n            \"reason\": \"最初のhere-documentは一時ファイル作成が拒否され、ハッシュ計算に入らなかった。書き込み不要の-c形式で再実施した。\"\n          },\n          {\n            \"foregroundOutputReference\": \"42f93e\",\n            \"exitCode\": 1,\n            \"reason\": \"Python実体の探索で存在しない候補をlsした。後続の純計算は存在する\/opt\/homebrew\/bin\/python3で正常終了した。\"\n          }\n        ],\n        \"completeLogPath\": null,\n        \"meaning\": \"失敗したコマンドを合格検証として数えていない。実行中のシェルセッションは残っていない。\"\n      },\n      {\n        \"phase\": \"終了時ハッシュ再検証\",\n        \"files\": 21,\n        \"mismatches\": [],\n        \"manifestSha256\": \"6ce0c9643ceda392cd2aa57420761a250a6ed7e3602dc82b848f0f9e2bdc064e\",\n        \"guidelineSha256\": \"29c9382c22d1f25f436176c112195280aa1d882383d1e8be234dc96c93995387\",\n        \"exitCode\": 0,\n        \"foregroundOutputReference\": \"7a3a64\",\n        \"completeLogPath\": null\n      }\n    ],\n    \"limitations\": [\n      \"新しい01c\/01dはDB未実行。SQL実行可能性、所要時間、I\/O、負荷、20分以内の完走は確認していない。\",\n      \"今回のシェル検証は完結したツール出力と終了コードを保持したが、READ ONLYのため独立した完結ログファイルを新設していない。ログファイルを要する正式な実行証明へ置き換えない。\",\n      \"通常の独立一様抽出というモデルに対する境界式を確認した。固定seedの有限実験は本番での95%被覆の実証ではなく、定理の独立した形式証明も実施していない。\",\n      \"全ケース・全目標・再試行を合わせた95%保証はない。各呼び出しに同じ名目alpha上限を使うが、look数の違いで実際の配分合計は異なる。\",\n      \"真値COUNT、作成直後の状態、前アームからの持越し、ホスト・VMキャッシュは制御されない。CPU・I\/Oのglobal差分には観測処理と背景処理が含まれ、方法単体の資源量ではない。\",\n      \"サービスは固定の密な750000行、100列TDE、100 read\/s・100 update\/sの局所条件。INSERT\/DELETE、負荷飽和、任意の暗号文幅、物理的な隔離、50列での10%サービス影響、5%サービス影響は今回の新設計では未計測。\",\n      \"7秒の回復観測は回復完了の証明ではない。到着保存則の一致だけでも、エラーがないこと、サービスSLO合格、サーバー処理の終了確認にはならない。\"\n    ],\n    \"claimEvidenceMap\": [\n      {\n        \"claim\": \"precision到達、実現誤差、信頼度は別物である。\",\n        \"evidence\": \"samplinglib.py:83〜93、accuracy_frontier.py:111〜113、docs\/probability-count.md:16〜24。\",\n        \"assessment\": \"設計上の区別は妥当。下側区間端を分母にする判定は保守的。target_reachedでも確率的な被覆失敗はあり得るため、絶対的な正確さを意味しない。\"\n      },\n      {\n        \"claim\": \"復元抽出・途中停止でも宣言した誤差確率を管理する。\",\n        \"evidence\": \"samplinglib.py:70〜86、sampling_bounds.py:16〜25。\",\n        \"assessment\": \"固定lookへのalpha配分と2種類の境界への配分がある。復元抽出なので、重複標本を除いた数や非復元抽出用の有限母集団補正で不当に狭めていない。domainでの上限切りも一意整数キーの条件に対応する。\"\n      },\n      {\n        \"claim\": \"10%を許容すれば常に最速になる。\",\n        \"evidence\": \"PROTOCOLSと純計算の188\/192セル例。\",\n        \"assessment\": \"成立しない。今回比較するのは目標別の停止プロトコルである。許容精度を満たす全候補の費用を比較すれば、この制約下でも有用な選択ができる。\"\n      },\n      {\n        \"claim\": \"疎密・幅・暗号化・キャッシュは同じ種類の精度要因である。\",\n        \"evidence\": \"7 fixtureの生成式、sampling_bounds.py、reqwide.pyの表・負荷設計。\",\n        \"assessment\": \"区別が必要。セル密度の分散と疎さは区間収束に影響する。幅・索引・TDE・キャッシュ・MVCCは主に費用と予算内に得られる精度へ影響する。完了した同一ビューのCOUNTを近似値にはしない。更新やレプリカ遅延による対象時点差は別問題。\"\n      },\n      {\n        \"claim\": \"100列では標本が正確COUNTより有利である。\",\n        \"evidence\": \"保持した01bのstaticとservice。\",\n        \"assessment\": \"条件付きでのみ成立。小索引なしの静的比較では標本が短いが、小索引ありではCOUNTが短い。負荷中の1秒予算とサービス影響は別に評価する必要があり、01dにはその判断価値がある。\"\n      },\n      {\n        \"claim\": \"プロセス成功やcomplete=trueで精度・サービス・後始末も合格になる。\",\n        \"evidence\": \"accuracy_frontier.pyのcomplete、samplinglib.pyの独立状態、lab.rbのok条件。\",\n        \"assessment\": \"成立しない。期待した精度未達・予算到達を含んで実験完了になり得る。加えてSOL-FRONTIER-003の撤去結果の欠落を修正する必要がある。\"\n      }\n    ],\n    \"validationCoverageMatrix\": [\n      {\n        \"area\": \"3\/5\/10%・初回look\",\n        \"coverage\": \"事前宣言済み。ゼロ分散なら各初回lookで到達可能と純計算で確認。\",\n        \"status\": \"設計確認。費用は未計測。\"\n      },\n      {\n        \"area\": \"alpha・途中停止・反復\",\n        \"coverage\": \"look別配分、境界別配分、固定paired seed、呼び出し単位の保証範囲を明記。\",\n        \"status\": \"設計確認。全試行の共同保証なし。\"\n      },\n      {\n        \"area\": \"母集団・真値\",\n        \"coverage\": \"01cはROW_COUNTの挿入実績を合算し、初回および対応COUNTと照合する。MIN\/MAXを真値の代わりにしない。\",\n        \"status\": \"設計確認。実際の照合は未実行。\"\n      },\n      {\n        \"area\": \"7分布\",\n        \"coverage\": \"dense、negative、gaps、islands、wide、moderate_gaps、uneven_density。\",\n        \"status\": \"主要な成功・失敗条件を比較できる。任意分布や行幅の異質性への網羅保証なし。\"\n      },\n      {\n        \"area\": \"静的費用の比較\",\n        \"coverage\": \"目標順の循環、COUNT前後の交替、並列読取1、global読取カウンタ。\",\n        \"status\": \"継承したキャッシュでの条件付き方式比較として有用。暗号処理単独の倍率、等しいcold状態、初回速度の因果主張には使えない。\"\n      },\n      {\n        \"area\": \"接続と時間範囲\",\n        \"coverage\": \"静的比較は接続再利用、サービスは新規接続。方法時間は接続確立を除外し、標本は最初のSQLからROLLBACKまで。\",\n        \"status\": \"比較範囲の明示は妥当。利用者が受け取るまでの全所要時間とは異なる。\"\n      },\n      {\n        \"area\": \"100列サービス48アーム\",\n        \"coverage\": \"control\/exact\/3%\/10%、索引有無、更新2種類、3反復、順序循環。\",\n        \"status\": \"目的に対応。SOL-FRONTIER-002により予算中断後の継続を要修正。5%は意図的に未計測。\"\n      },\n      {\n        \"area\": \"サービス遅延と到着保存\",\n        \"coverage\": \"actual statement\/method区間とtrial、予定時刻起点の遅延、queued\/stuck、global保存則、dispatch\/client実行時間。\",\n        \"status\": \"未完了要求を落とす問題への対策がある。slo_assessableは打切りの有無であり、SLO合格フラグとして使わない。\"\n      },\n      {\n        \"area\": \"CPU・監視・回復\",\n        \"coverage\": \"DB CPU0\/1、負荷CPU2、方法CPU3、共通監視、7秒回復。\",\n        \"status\": \"クライアント干渉を減らす設計。共有VM資源・観測負荷は残り、CPUカウンタは総CPUではない。SOL-FRONTIER-004の未計測0を修正推奨。\"\n      },\n      {\n        \"area\": \"20分・集約guard・出力・出典\",\n        \"coverage\": \"runnerの1200秒上限、wrapperの18分見積りによる開始判定、必須.outputs、依存閉包と成果物ハッシュ。\",\n        \"status\": \"guardのexit 3とtimeoutを成功にしない設計は妥当。18分は実測保証や実行中の集約上限ではない。SOL-FRONTIER-001と003が未解決。\"\n      }\n    ],\n    \"priorityFixes\": [\n      {\n        \"priority\": 1,\n        \"finding\": \"SOL-FRONTIER-002\",\n        \"action\": \"設定した文予算への到達を分類し、安全に終了確認できた予算失敗の後にも10%比較を残せるようにする。\"\n      },\n      {\n        \"priority\": 2,\n        \"finding\": \"SOL-FRONTIER-001\",\n        \"action\": \"標本結果を先に永続化し、比較COUNTや観測処理の二次障害で失わないようにする。\"\n      },\n      {\n        \"priority\": 3,\n        \"finding\": \"SOL-FRONTIER-003\",\n        \"action\": \"runner所有資源の後始末状態を記録し、確認不能を実行成功へ含めない。\"\n      },\n      {\n        \"priority\": 4,\n        \"finding\": \"SOL-FRONTIER-004\",\n        \"action\": \"無効なロック観測を未計測として表現する。\"\n      }\n    ]\n  }\n}","eventType":"agent_message_chunk","sequence":5}],"status":"completed","stepId":"sol-adversarial-review","streamedResponseText":"不変スナップショットとハッシュを先に確認し、DBへ接続せずに設計・判定ロジックを査読します。設計の実行準備と、本番向け推奨の承認は分けて判断します。21ファイルのハッシュがすべてmanifestと一致しました。標本の信頼区間と途中停止には保守的な判定が実装されています。続いて、48アームの障害時の保存・後始末と、比較結果から言える範囲を確認します。障害時に、標本の失敗結果を保存する前に比較COUNTを実行する経路が見つかりました。比較COUNTも失敗すると、元の標本エラーがJSONに残りません。また、サービスアームの終了後に残存処理を確認する仕組みと、無効にしたロック観測を0として返す点を確認しています。既存の100列の観測もハッシュを確認しました。3%標本は小索引なしの6アームすべてで1秒予算に達しており、10%で必要な抽出数を減らす実験には判断価値があります。一方、目標別の判定時点によっては5%用プロトコルが10%用より少ない抽出で終わる例も純計算で確認できました。方式名ではなく、達成精度・費用・負荷を合わせて比較する必要があります。{\n  \"when\": {},\n  \"payload\": {\n    \"decision\": \"rejected\",\n    \"guidelineSha256\": \"29c9382c22d1f25f436176c112195280aa1d882383d1e8be234dc96c93995387\",\n    \"reviewScope\": {\n      \"judgment\": \"3\/5\/10%精度・費用比較の設計実行準備のみ。未解決middleが3件あるため差し戻す。DB未実行であること自体は差し戻し理由ではない。\",\n      \"snapshotRoot\": \"results\/reference\/20261107-frontier-design\",\n      \"manifestSha256\": \"6ce0c9643ceda392cd2aa57420761a250a6ed7e3602dc82b848f0f9e2bdc064e\",\n      \"startHashVerification\": \"manifestの21ファイルすべて一致。guidelineSha256も指定値と一致。\",\n      \"endHashVerification\": \"査読終了時も21ファイルすべて一致。manifest・ガイドラインのハッシュは開始時と同一。\",\n      \"snapshotFilesRead\": [\n        \"bench\/accuracy_frontier.py\",\n        \"bench\/requested\/01c-ACCURACY-COST.py\",\n        \"bench\/requested\/01d-ACCURACY-SERVICE-100.py\",\n        \"bench\/requested\/01c-ACCURACY-COST.outputs\",\n        \"bench\/requested\/01d-ACCURACY-SERVICE-100.outputs\",\n        \"bench\/requested\/01c-ACCURACY-COST.versions\",\n        \"bench\/requested\/01d-ACCURACY-SERVICE-100.versions\",\n        \"bench\/requested\/01c-ACCURACY-COST.encrypted\",\n        \"bench\/requested\/01d-ACCURACY-SERVICE-100.encrypted\",\n        \"bench\/samplinglib.py\",\n        \"bench\/sampling_bounds.py\",\n        \"bench\/reqwide.py\",\n        \"bench\/lablib.py\",\n        \"bench\/reqlib.py\",\n        \"bench\/dependencies.py\",\n        \"lab.rb\",\n        \"compose.yaml\",\n        \"docs\/table-count-guideline.md\",\n        \"docs\/probability-count.md\",\n        \"results\/reviews\/accuracy-frontier-design-check.json\",\n        \"results\/reviews\/accuracy-frontier-existing-evidence.json\"\n      ],\n      \"revisionBoundary\": \"指摘の行番号は上記スナップショット基準。results\/reviews\/full-review-input.jsonと検索で表示された現行ファイルは背景情報としてのみ使用し、後日の編集で指摘を解消済みとは扱っていない。\",\n      \"operations\": \"ファイル読み取り、ハッシュ、AST解析、DBを使わない算術のみ。DB接続・Docker操作・負荷生成・実験実行・編集・別ワークフロー・委任は行っていない。\"\n    },\n    \"findings\": [\n      {\n        \"id\": \"SOL-FRONTIER-001\",\n        \"severity\": \"middle\",\n        \"section\": \"01c：失敗結果の永続化\",\n        \"scenario\": \"sample_then_countのアームで標本接続が切れ、sampleがquery_failedまたはcleanup_failedを返す。その後、同じ接続で比較COUNTを実行すると再び例外になる。\",\n        \"evidence\": [\n          \"bench\/accuracy_frontier.py:109でsampleの結果を受け取る。\",\n          \"同:114で比較COUNTを実行した後、116〜117で初めて標本結果をappend・保存する。\",\n          \"bench\/samplinglib.py:96〜104は問い合わせエラーとROLLBACKエラーを結果に格納して返す。\",\n          \"unexpected_failuresの構築はbench\/accuracy_frontier.py:122〜124のループ完了後だけ。\"\n        ],\n        \"impact\": \"元の標本エラー・精度状態・予算状態・後始末状態がJSONに残らず、ログには後続COUNTの例外だけが残り得る。complete=falseと非ゼロ終了により誤合格は防げるが、何が失敗したかの根拠と後続条件の観測を失う。\",\n        \"requiredCorrection\": \"標本結果を比較COUNTより先に識別情報付きで保存する。比較COUNTの失敗も別フィールドへ記録する。壊れた接続は再利用せず、終了確認後に再接続するか、継続不能として明示的に中止する。安全が確認できない状態で全アームの継続を要求するものではない。\"\n      },\n      {\n        \"id\": \"SOL-FRONTIER-002\",\n        \"severity\": \"middle\",\n        \"section\": \"01d：意図した問い合わせ上限と後続アーム\",\n        \"scenario\": \"最初のrepeatではsample3がsample10より先に動く。sample3の範囲COUNTが設定済み100ms上限に達して3024を返すと、sample10まで到達しない。\",\n        \"evidence\": [\n          \"bench\/samplinglib.py:44で各問い合わせにmax_execution_time=100を設定する。\",\n          \"同:96〜97は3024を含むMySQLErrorを一律query_failedにする。\",\n          \"bench\/accuracy_frontier.py:30はquery_failedをUNEXPECTEDに含める。\",\n          \"同:168〜178はcontrol\/count\/sample3\/sample10の順から始まり、query_failedを保存した直後に実験全体を中止する。\",\n          \"対照的にbench\/reqwide.py:70〜72のexact COUNTは1317・3024を記録して後続処理へ進む。\"\n        ],\n        \"impact\": \"比較したい『厳しい目標は予算内に完了しないが、緩い目標なら完了するか』という条件で、設定した問い合わせ上限への到達が後続の10%測定を止め得る。全体1秒のbudget_exhaustedは保持できているが、文単位の上限到達は同じ扱いになっていない。\",\n        \"requiredCorrection\": \"設定した文上限による中断を、構文・権限・接続などの予期しない障害から区別する。errnoと文予算到達を残し、終了・ROLLBACKを確認できた場合は後続アームへ進める。全体1秒を使い切ったと偽って分類せず、文予算と全体予算を分ける。原因不明の1317まで自動的に正常な予算到達へ変換しない。\"\n      },\n      {\n        \"id\": \"SOL-FRONTIER-003\",\n        \"severity\": \"middle\",\n        \"section\": \"実験完了と検証環境の後始末\",\n        \"scenario\": \"01dが48アームを完了した後、matrixコンテナの削除が失敗する。実験プロセス自体はexit 0で終了している。\",\n        \"evidence\": [\n          \"bench\/accuracy_frontier.py:180〜184はcomplete=trueを保存し、接続を閉じる。サービス用fixtureの撤去はrunner側に依存する。\",\n          \"lab.rb:181〜184は削除コマンドのremovedを受け取るが、失敗を上位へ伝播せず、撤去結果も成果物へ保存しない。\",\n          \"lab.rb:115のok条件は実験終了、必須出力、入力ハッシュ一致であり、撤去成功を含まない。\",\n          \"lab.rb:123〜129の既存データ検証は、当該matrixコンテナの撤去確認にはならない。\"\n        ],\n        \"impact\": \"実験完了と後始末完了を別に判定できず、検証用DBが残存してもrunnerが成功を報告し得る。01cのfixture_cleanupは有用だが、01dとrunner所有資源には同等の証拠がない。\",\n        \"requiredCorrection\": \"runnerが所有するコンテナ・データ領域の撤去結果を、実験結果とは別の状態として記録する。撤去失敗または確認不能なら実行全体を成功扱いしない。01d側で重複したDROPを増やす必要はなく、所有者であるrunnerの終了処理で確認する。\"\n      },\n      {\n        \"id\": \"SOL-FRONTIER-004\",\n        \"severity\": \"low\",\n        \"section\": \"サービス観測の未計測値\",\n        \"scenario\": \"ロック観測を無効にしたサービスアームでも、集計JSONには行ロック・テーブルロックのピークが0として出る。\",\n        \"evidence\": [\n          \"bench\/reqwide.py:51はSamplerをdata_locks=Falseで作る。\",\n          \"bench\/lablib.py:223〜226はこの場合row_locks_seenとtable_is_locksを収集しない。\",\n          \"同:257、274〜275は未収集キーを0として集計する。\"\n        ],\n        \"impact\": \"未計測が『観測して0だった』と読める。通常のSELECT COUNTが行ロックを取らないという説明自体とは別に、このJSONをその実測証拠にはできない。\",\n        \"requiredCorrection\": \"無効な観測はnullまたはnot_measuredとし、観測機能の有効状態を結果へ保存する。既存互換性のため0を残す場合も、測定値として集計・引用しない明確な状態を付ける。\"\n      }\n    ],\n    \"engineerQuestions\": [\n      {\n        \"question\": \"必要なのは、今回の参考値がおよそ10%以内という期待か、規定した信頼度付きの相対誤差境界か。\",\n        \"reason\": \"メタ情報と信頼区間付き標本では得られる保証が異なる。固定した合成表での成功割合を任意の本番表の成功確率には変換できない。\"\n      },\n      {\n        \"question\": \"許容する取得時点と、複数表・再実行を含めた保証範囲はどこまでか。\",\n        \"reason\": \"各呼び出しのfamily_alpha=.05は全サービス・全試行を合わせた95%保証ではない。レプリカやカウンタでは推定誤差と鮮度差も分ける必要がある。\"\n      },\n      {\n        \"question\": \"既存の小さい索引と、その索引列への更新頻度はどうなっているか。\",\n        \"reason\": \"保持した100列の静的観測では小索引上の正確COUNTが標本を大幅に上回る。一方、サービス負荷中の索引更新条件では正確COUNTにも中断があり、静的順位だけでは決められない。\"\n      },\n      {\n        \"question\": \"単一整数主キーに適用できない表や、既存の信頼できるカウンタを持つ表の経路は用意できるか。\",\n        \"reason\": \"セル標本は任意の未知表に適用できる方式ではなく、適用外を失敗や0件へ置き換えてはいけない。\"\n      }\n    ],\n    \"betterAlternatives\": [\n      {\n        \"method\": \"既存の小さい索引を使う正確COUNT\",\n        \"condition\": \"索引が小さく、同時更新・MVCC・利用可能資源の条件で予算を満たす場合。\",\n        \"evidence\": \"保持した01bの静的比較では小索引ありCOUNTが0.0494〜0.0723秒、標本が1.1712〜3.1946秒。\",\n        \"limits\": \"環境依存の比較。索引追加には構築・保管・更新費用があり、サービス負荷中の安全性をこの静的結果から認定しない。\"\n      },\n      {\n        \"method\": \"既存メタ情報を参考値として利用\",\n        \"condition\": \"保証付き誤差境界を要求せず、まず規模を知りたい場合。\",\n        \"evidence\": \"保存された後期58表の比較ではexpiry=0のTABLE_ROWSがANALYZE前57\/58、後55\/58で実現誤差10%以内だった。\",\n        \"limits\": \"この合成表集合の観測であり、普遍的な10%保証ではない。未初期化・取得不可・統計の古さを明示し、初手にANALYZEを加えない。\"\n      },\n      {\n        \"method\": \"許容誤差内に入った全プロトコルから費用の低いものを選ぶ\",\n        \"condition\": \"10%を許容する場合でも、3%用・5%用・10%用をすべて候補として比較する。\",\n        \"evidence\": \"純計算の可能な標本列では、セル件数188\/192が半々のとき5%用は320抽出で境界約4.87%へ達するが、10%用は160抽出で約10.13%となり次の640抽出まで進む。\",\n        \"limits\": \"抽出数の例であり時間の測定ではない。目標別スケジュールの比較は有用だが、『緩い目標ほど必ず安い』や数学的最適方式という主張はできない。完全な最適化探索は要求しない。\"\n      },\n      {\n        \"method\": \"既存カウンタ・CDC、または余力のある隔離先でのCOUNT\",\n        \"condition\": \"頻繁な取得、またはprimaryで走査する余力がなく、必要な鮮度を満たせる場合。\",\n        \"limits\": \"カウンタには整合した初期件数、削除・再試行・移行の追跡が必要。隔離先には復元・鍵・容量・運用責任があり、レプリカの正確値とprimary現在値は同一ではない。これらの費用は今回未計測。\"\n      }\n    ],\n    \"requestedExperiments\": [\n      {\n        \"id\": \"SOL-FRONTIER-EXP-01\",\n        \"protocol\": \"修正後の既存01c-ACCURACY-COST\",\n        \"scope\": \"7 fixture×5 seed×3目標の105標本結果と対応する実COUNT。\",\n        \"decisionItCanChange\": \"密度偏り・中程度欠番で、3%から5%または10%へ緩めることで全件COUNTより有利になるか。細い表・極端な疎領域でCOUNTを選ぶべきか。\",\n        \"requiredEvidence\": \"挿入実績と初回COUNTの一致、各目標の達成境界・実現誤差・真値被覆、失敗を含む時間と読取量、順序、後始末、終了コード、完結ログ、依存ソースと成果物のハッシュ。\",\n        \"restriction\": \"既存所有者の終了後にCompose検証環境だけで実施する。本査読では実行していない。\"\n      },\n      {\n        \"id\": \"SOL-FRONTIER-EXP-02\",\n        \"protocol\": \"修正後の既存01d-ACCURACY-SERVICE-100\",\n        \"scope\": \"control\/exact\/3%\/10%×索引有無×更新2種類×3反復の48アーム。\",\n        \"decisionItCanChange\": \"既存3%で予算未達だった100列表で、10%の少ない抽出が精度判定と1秒予算を両立するか。小索引や索引更新でCOUNTとの選択が変わるか。\",\n        \"requiredEvidence\": \"文単位と全体の予算到達を残し、actual_method_serviceと3秒trialを分ける。予定到着数の保存則、打切り、エラー、回復、監視失敗と後始末も保持する。\",\n        \"restriction\": \"5%サービス影響は未計測のままでよい。短窓の改善をSLO合格や本番無影響と呼ばない。今回の目的のために50列・全版・全分布のサービス直積を追加する必要はない。\"\n      }\n    ],\n    \"rolloutRecommendation\": {\n      \"designReadiness\": \"SOL-FRONTIER-001〜003を修正して再確認するまで差し戻し。\",\n      \"rolloutReadiness\": \"保留。設計が受理されても本番導入承認にはならない。\",\n      \"remainingGates\": [\n        \"修正版01c\/01dの実測と、期待した精度未達・予算到達を含む結果の統合。\",\n        \"最終コードによる白紙DBからのmise run allと、数値終了コード・完結ログ・意味上の結果・後始末の確認。\",\n        \"固定した最終成果物について、執筆とは別セッションで行う最終2段階Solレビュー。\"\n      ],\n      \"currentGuidance\": \"参考統計、条件付きの確率推定、読み取りビューの正確COUNTを分ける。通常のSELECT COUNT(*)は行ロックを取らないがMDLと資源負荷があり、INSERT ... SELECT COUNT(*)等は読み取り元をロックする場合があるという区別を維持する。\"\n    },\n    \"reviewEvidence\": [\n      {\n        \"phase\": \"開始時ハッシュ検証\",\n        \"files\": 21,\n        \"mismatches\": [],\n        \"guidelineSha256\": \"29c9382c22d1f25f436176c112195280aa1d882383d1e8be234dc96c93995387\",\n        \"exitCode\": 0,\n        \"foregroundOutputReference\": \"efc351\",\n        \"completeLogPath\": null,\n        \"logNote\": \"完結した標準出力はツール記録に保持。READ ONLYのため新規ログファイルは作成していない。\"\n      },\n      {\n        \"phase\": \"静的解析・純計算\",\n        \"checks\": [\n          \"スナップショットのPython 9ファイルをAST解析。\",\n          \"01c\/01dの静的依存閉包を計算し、reqwide・samplinglib・sampling_bounds・lablib・reqlibを含むことを確認。\",\n          \"実装された境界式で、ゼロ分散の各初回lookが目標へ到達可能であることを確認。\",\n          \"3-lookのalpha支出合計0.0375、4-lookの合計0.04で、いずれも宣言値0.05以下と確認。\",\n          \"巨大な疎領域で全標本0でも下端0・相対境界なしとなり、精度達成にならない例を確認。\",\n          \"5%用が10%用より少ない抽出で停止し得るスケジュール例を確認。\"\n        ],\n        \"exitCode\": 0,\n        \"foregroundOutputReferences\": [\n          \"055c16\",\n          \"2580cb\",\n          \"6cb0ec\"\n        ],\n        \"completeLogPath\": null,\n        \"meaning\": \"構文・依存関係・算術の確認。DB測定、被覆確率の実証、サービス合格の証拠ではない。\"\n      },\n      {\n        \"phase\": \"保存済み観測の照合\",\n        \"snapshotRoot\": \"results\/reference\/20261107-wide-sampling\",\n        \"verifiedManifestFiles\": 24,\n        \"mismatches\": [],\n        \"semanticRead\": [\n          \"manifest.json\",\n          \"results\/requested_probability_wide_100.jsonのstatic・service・完了状態\",\n          \"results\/requested\/01b-PROB-WIDE-100.status.json\",\n          \"01a\/01bのログ末尾\"\n        ],\n        \"historicalRunExitCode\": 0,\n        \"completeLogPath\": \"results\/reference\/20261107-wide-sampling\/results\/requested\/01b-PROB-WIDE-100.log\",\n        \"completeLogSha256\": \"29658fddc8140172ed54086bc92a53b3e26fed63c2785c22b917d12bb7736bc2\",\n        \"observations\": \"100列の36サービスアームの到着保存則は全件consistent=true。3%標本は小索引なし6\/6、小索引あり3\/6でbudget_exhausted。新しい48アームの結果ではない。\",\n        \"verificationCommandExitCode\": 0,\n        \"foregroundOutputReferences\": [\n          \"886aea\",\n          \"7e37fe\"\n        ]\n      },\n      {\n        \"phase\": \"過去観測からの派生資料\",\n        \"path\": \"results\/reference\/20261107-frontier-design\/results\/reviews\/accuracy-frontier-existing-evidence.json\",\n        \"sourceHashChecks\": \"指定されたmetadata_accuracyとfixed-samplingの原本2ファイルは、記載SHA-256と一致。\",\n        \"exitCode\": 0,\n        \"foregroundOutputReference\": \"7e37fe\",\n        \"completeLogPath\": null,\n        \"meaning\": \"過去観測と新規実験を区別した。過去のcheckpoint再生から未観測の停止時間を推定していない。\"\n      },\n      {\n        \"phase\": \"検証コマンドの不成立\",\n        \"items\": [\n          {\n            \"foregroundOutputReference\": \"b07873\",\n            \"exitCode\": 1,\n            \"reason\": \"最初のhere-documentは一時ファイル作成が拒否され、ハッシュ計算に入らなかった。書き込み不要の-c形式で再実施した。\"\n          },\n          {\n            \"foregroundOutputReference\": \"42f93e\",\n            \"exitCode\": 1,\n            \"reason\": \"Python実体の探索で存在しない候補をlsした。後続の純計算は存在する\/opt\/homebrew\/bin\/python3で正常終了した。\"\n          }\n        ],\n        \"completeLogPath\": null,\n        \"meaning\": \"失敗したコマンドを合格検証として数えていない。実行中のシェルセッションは残っていない。\"\n      },\n      {\n        \"phase\": \"終了時ハッシュ再検証\",\n        \"files\": 21,\n        \"mismatches\": [],\n        \"manifestSha256\": \"6ce0c9643ceda392cd2aa57420761a250a6ed7e3602dc82b848f0f9e2bdc064e\",\n        \"guidelineSha256\": \"29c9382c22d1f25f436176c112195280aa1d882383d1e8be234dc96c93995387\",\n        \"exitCode\": 0,\n        \"foregroundOutputReference\": \"7a3a64\",\n        \"completeLogPath\": null\n      }\n    ],\n    \"limitations\": [\n      \"新しい01c\/01dはDB未実行。SQL実行可能性、所要時間、I\/O、負荷、20分以内の完走は確認していない。\",\n      \"今回のシェル検証は完結したツール出力と終了コードを保持したが、READ ONLYのため独立した完結ログファイルを新設していない。ログファイルを要する正式な実行証明へ置き換えない。\",\n      \"通常の独立一様抽出というモデルに対する境界式を確認した。固定seedの有限実験は本番での95%被覆の実証ではなく、定理の独立した形式証明も実施していない。\",\n      \"全ケース・全目標・再試行を合わせた95%保証はない。各呼び出しに同じ名目alpha上限を使うが、look数の違いで実際の配分合計は異なる。\",\n      \"真値COUNT、作成直後の状態、前アームからの持越し、ホスト・VMキャッシュは制御されない。CPU・I\/Oのglobal差分には観測処理と背景処理が含まれ、方法単体の資源量ではない。\",\n      \"サービスは固定の密な750000行、100列TDE、100 read\/s・100 update\/sの局所条件。INSERT\/DELETE、負荷飽和、任意の暗号文幅、物理的な隔離、50列での10%サービス影響、5%サービス影響は今回の新設計では未計測。\",\n      \"7秒の回復観測は回復完了の証明ではない。到着保存則の一致だけでも、エラーがないこと、サービスSLO合格、サーバー処理の終了確認にはならない。\"\n    ],\n    \"claimEvidenceMap\": [\n      {\n        \"claim\": \"precision到達、実現誤差、信頼度は別物である。\",\n        \"evidence\": \"samplinglib.py:83〜93、accuracy_frontier.py:111〜113、docs\/probability-count.md:16〜24。\",\n        \"assessment\": \"設計上の区別は妥当。下側区間端を分母にする判定は保守的。target_reachedでも確率的な被覆失敗はあり得るため、絶対的な正確さを意味しない。\"\n      },\n      {\n        \"claim\": \"復元抽出・途中停止でも宣言した誤差確率を管理する。\",\n        \"evidence\": \"samplinglib.py:70〜86、sampling_bounds.py:16〜25。\",\n        \"assessment\": \"固定lookへのalpha配分と2種類の境界への配分がある。復元抽出なので、重複標本を除いた数や非復元抽出用の有限母集団補正で不当に狭めていない。domainでの上限切りも一意整数キーの条件に対応する。\"\n      },\n      {\n        \"claim\": \"10%を許容すれば常に最速になる。\",\n        \"evidence\": \"PROTOCOLSと純計算の188\/192セル例。\",\n        \"assessment\": \"成立しない。今回比較するのは目標別の停止プロトコルである。許容精度を満たす全候補の費用を比較すれば、この制約下でも有用な選択ができる。\"\n      },\n      {\n        \"claim\": \"疎密・幅・暗号化・キャッシュは同じ種類の精度要因である。\",\n        \"evidence\": \"7 fixtureの生成式、sampling_bounds.py、reqwide.pyの表・負荷設計。\",\n        \"assessment\": \"区別が必要。セル密度の分散と疎さは区間収束に影響する。幅・索引・TDE・キャッシュ・MVCCは主に費用と予算内に得られる精度へ影響する。完了した同一ビューのCOUNTを近似値にはしない。更新やレプリカ遅延による対象時点差は別問題。\"\n      },\n      {\n        \"claim\": \"100列では標本が正確COUNTより有利である。\",\n        \"evidence\": \"保持した01bのstaticとservice。\",\n        \"assessment\": \"条件付きでのみ成立。小索引なしの静的比較では標本が短いが、小索引ありではCOUNTが短い。負荷中の1秒予算とサービス影響は別に評価する必要があり、01dにはその判断価値がある。\"\n      },\n      {\n        \"claim\": \"プロセス成功やcomplete=trueで精度・サービス・後始末も合格になる。\",\n        \"evidence\": \"accuracy_frontier.pyのcomplete、samplinglib.pyの独立状態、lab.rbのok条件。\",\n        \"assessment\": \"成立しない。期待した精度未達・予算到達を含んで実験完了になり得る。加えてSOL-FRONTIER-003の撤去結果の欠落を修正する必要がある。\"\n      }\n    ],\n    \"validationCoverageMatrix\": [\n      {\n        \"area\": \"3\/5\/10%・初回look\",\n        \"coverage\": \"事前宣言済み。ゼロ分散なら各初回lookで到達可能と純計算で確認。\",\n        \"status\": \"設計確認。費用は未計測。\"\n      },\n      {\n        \"area\": \"alpha・途中停止・反復\",\n        \"coverage\": \"look別配分、境界別配分、固定paired seed、呼び出し単位の保証範囲を明記。\",\n        \"status\": \"設計確認。全試行の共同保証なし。\"\n      },\n      {\n        \"area\": \"母集団・真値\",\n        \"coverage\": \"01cはROW_COUNTの挿入実績を合算し、初回および対応COUNTと照合する。MIN\/MAXを真値の代わりにしない。\",\n        \"status\": \"設計確認。実際の照合は未実行。\"\n      },\n      {\n        \"area\": \"7分布\",\n        \"coverage\": \"dense、negative、gaps、islands、wide、moderate_gaps、uneven_density。\",\n        \"status\": \"主要な成功・失敗条件を比較できる。任意分布や行幅の異質性への網羅保証なし。\"\n      },\n      {\n        \"area\": \"静的費用の比較\",\n        \"coverage\": \"目標順の循環、COUNT前後の交替、並列読取1、global読取カウンタ。\",\n        \"status\": \"継承したキャッシュでの条件付き方式比較として有用。暗号処理単独の倍率、等しいcold状態、初回速度の因果主張には使えない。\"\n      },\n      {\n        \"area\": \"接続と時間範囲\",\n        \"coverage\": \"静的比較は接続再利用、サービスは新規接続。方法時間は接続確立を除外し、標本は最初のSQLからROLLBACKまで。\",\n        \"status\": \"比較範囲の明示は妥当。利用者が受け取るまでの全所要時間とは異なる。\"\n      },\n      {\n        \"area\": \"100列サービス48アーム\",\n        \"coverage\": \"control\/exact\/3%\/10%、索引有無、更新2種類、3反復、順序循環。\",\n        \"status\": \"目的に対応。SOL-FRONTIER-002により予算中断後の継続を要修正。5%は意図的に未計測。\"\n      },\n      {\n        \"area\": \"サービス遅延と到着保存\",\n        \"coverage\": \"actual statement\/method区間とtrial、予定時刻起点の遅延、queued\/stuck、global保存則、dispatch\/client実行時間。\",\n        \"status\": \"未完了要求を落とす問題への対策がある。slo_assessableは打切りの有無であり、SLO合格フラグとして使わない。\"\n      },\n      {
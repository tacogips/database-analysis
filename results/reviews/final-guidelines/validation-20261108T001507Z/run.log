     \"sqlServer\": {\n        \"completeLogPath\": \"results\/reference\/final-sqlserver-52556dd\/results\/sqlserver\/runs\/20261107T230105Z-8533a31e\/runner.log\",\n        \"exitCode\": 0,\n        \"logHashMatches\": true,\n        \"commandLogsComplete\": 1331,\n        \"serviceBudget\": \"unavailable。本番SLO合格としていない。\"\n      }\n    },\n    {\n      \"check\": \"公式仕様\",\n      \"mysql\": \"統計cache miss時のengine取得と通常InnoDB整合性読取の説明を確認。[TABLES仕様](https:\/\/dev.mysql.com\/doc\/refman\/8.4\/en\/information-schema-tables-table.html)、[整合性読取](https:\/\/dev.mysql.com\/doc\/refman\/8.4\/en\/innodb-consistent-read.html)\",\n      \"sqlServer\": \"partition概数・権限、分離レベル、AGのsnapshot mapping・primary回収影響と整合。[partition DMV](https:\/\/learn.microsoft.com\/en-us\/sql\/relational-databases\/system-dynamic-management-objects\/sys-dm-db-partition-stats-transact-sql?view=sql-server-ver17)、[分離レベル](https:\/\/learn.microsoft.com\/en-us\/sql\/t-sql\/statements\/set-transaction-isolation-level-transact-sql?view=sql-server-ver17)、[AG制限](https:\/\/learn.microsoft.com\/en-us\/sql\/database-engine\/availability-groups\/windows\/active-secondaries-readable-secondary-replicas-always-on-availability-groups?view=sql-server-ver17)\"\n    },\n    {\n      \"check\": \"最終読み取り確認\",\n      \"currentDocumentHashesRechecked\": true,\n      \"localLinksChecked\": 32,\n      \"missingLinks\": 0,\n      \"foregroundVerificationExitCode\": 0,\n      \"terminalOutputChunk\": \"ed1ad0\",\n      \"executionScope\": \"DB・Docker・計測・workflow・委任・公開・ファイル変更は実施していない。実行中のshell sessionは残っていない。\"\n    }\n  ]\n}","updatedAt":"2026-11-08T00:18:14Z","usage":{"inputTokens":817848,"outputTokens":7633,"providerRaw":{},"totalTokens":825481}}],"instanceConfiguration":{},"instanceIdentity":"default","instanceKind":"default","reviewFindings":[],"rootSessionId":"temp-final-count-guidelines-validation-sol-session-42","sessionId":"temp-final-count-guidelines-validation-sol-session-42","status":"completed","updatedAt":"2026-11-08T00:18
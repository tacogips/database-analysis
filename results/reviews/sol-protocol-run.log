tations\": [\n      \"今回実行中の増大する結果ファイル、DB、Docker、実行セッションは確認していない。現実行の成功・失敗、完了時間、精度、SLOを判定していない。\",\n      \"固定design snapshotにはscaleの全30wrapperと各versions\/outputsが含まれていない。計画の30件と共通arm生成は確認したが、全wrapperの実引数とfresh-server実行履歴の最終照合は所有者監査に残る。\",\n      \"新規raw chunkの実データは本スナップショットに含まれない。保存・読出しコードを査読したが、現在実行のchunk整合を検証したとは主張しない。\",\n      \"reqmix2の05〜08はtail_splits既定値0でno-count controlを持たず、raw_service_samples・arrival_accountingも成果物へ保存しない。集計値から新しい比較窓を復元できるとは扱わない。\",\n      \"scaleのmatched controlは期間を対応させるもので、cache、HLL、purge、先行armの履歴が同一である証明ではない。再校正されたcapacityと実現負荷も別に照合する必要がある。\",\n      \"FORCE INDEX、EXPLAIN、Handler差分だけで内部COUNT索引を断定しない。両armが打切りなら報告cutoffで順位を付けない。\",\n      \"guideの現実行に関する記述は統合前の履歴として読んだ。最終証拠未完成や古い進捗記述自体を今回の新規findingにはしていない。\",\n      \"サポート状況、公式仕様、暗号化・精度比較全体の再査読は今回の静的プロトコル査読範囲外。\"\n    ],\n    \"claimEvidenceMap\": [\n      {\n        \"claim\": \"partitioned-v2は5条件×2群×3反復と元の300秒\/150秒上限を宣言する\",\n        \"evidence\": [\n          \"results\/reference\/20261107-protocol-design\/bench\/requested\/primary-scale-plan.json\",\n          \"results\/reference\/20261107-protocol-design\/bench\/reqscale.py:13–14,105–137\"\n        ],\n        \"assessment\": \"設計宣言は確認。実行充足は未判定。\"\n      },\n      {\n        \"claim\": \"scaleでは未着手や予期しないarm失敗をscope成功にしない\",\n        \"evidence\": [\n          \"results\/reference\/20261107-protocol-design\/bench\/reqscale.py:117–121,171–189,220–222\",\n          \"results\/reference\/20261107-protocol-design\/bench\/reqlib.py:46–64\"\n        ],\n        \"assessment\": \"静的に支持。setup予算不足やsection例外は成功に隠れない。\"\n      },\n      {\n        \"claim\": \"reqmix2のnon-completeは予定上限である\",\n        \"evidence\": [\n          \"results\/reference\/20261107-protocol-design\/bench\/reqmix.py:57–76,180–190\"\n        ],\n        \"assessment\": \"支持できない。SOL-PROTOCOL-001。\"\n      },\n      {\n        \"claim\": \"reqmix2の正常終了は必要な比較反復の完了を意味する\",\n        \"evidence\": [\n          \"results\/reference\/20261107-protocol-design\/bench\/reqmix.py:175–192,245\",\n          \"RE-02\"\n        ],\n        \"assessment\": \"支持できない。SOL-PROTOCOL-002。\"\n      },\n      {\n        \"claim\": \"到着数を落とさず未完了latencyを識別する\",\n        \"evidence\": [\n          \"results\/reference\/20261107-protocol-design\/bench\/lablib.py:92–108,175–201\"\n        ],\n        \"assessment\": \"共通実装は支持。未着手・未完了を保存し、遅延を下限打切りと表示する。DB処理終了やSLO合格の証明とは別。\"\n      },\n      {\n        \"claim\": \"raw保存とcache整合は観測の追跡を支える\",\n        \"evidence\": [\n          \"results\/reference\/20261107-protocol-design\/bench\/raw_evidence.py:26–97\",\n          \"results\/reference\/20261107-protocol-design\/bench\/reqscale.py:212–215\",\n          \"results\/reference\/20261107-protocol-design\/lab.rb:122–132,271–324\"\n        ],\n        \"assessment\": \"サイズ・圧縮前後SHA・件数を検証できる設計。runnerの存在・artifact SHA確認だけではraw内manifest整合やsemantic successを代替しない。\"\n      },\n      {\n        \"claim\": \"3e\/3fの退役後も元のwrite-shape仮説は残る\",\n        \"evidence\": [\n          \"results\/reference\/review-20261107T040818Z-62807\/bench\/reqruns.py:190–194,222–305\",\n          \"results\/reference\/20261107-protocol-design\/bench\/reqmix.py:16–27\",\n          \"results\/reference\/20261107-protocol-design\/bench\/requested\/retired-protocols.json\"\n        ],\n        \"assessment\": \"仮説は保存。旧コードの復活や同一負荷率での再現を要求しない。置換実験の成功は別途判定。\"\n      }\n    ],\n    \"validationCoverageMatrix\": [\n      {\n        \"area\": \"スナップショット不変性\",\n        \"coverage\": \"開始・終了とも15\/15ハッシュ一致\",\n        \"status\": \"静的確認済み\"\n      },\n      {\n        \"area\": \"scale必須範囲・上限\",\n        \"coverage\": \"5×2×3、30 unique scripts、300秒\/150秒\",\n        \"status\": \"計画確認済み。全wrapperと実行充足は保留\"\n      },\n      {\n        \"area\": \"scale予算\",\n        \"coverage\": \"uniform core 990秒、indexed core 840秒、secondary 690秒の開始時reserve\",\n        \"status\": \"setupがreserveを消費した場合はscope不成立。実測で足りたかは未判定\"\n      },\n      {\n        \"area\": \"section例外\",\n        \"coverage\": \"Resultsは例外を保存して継続しfinishで非0化。scaleはbuild\/rateとscopeを追加確認\",\n        \"status\": \"reqmixの返却status・省略は例外にならず穴が残る\"\n      },\n      {\n        \"area\": \"予期した打切りと失敗\",\n        \"coverage\": \"scaleは2013を期待結果に含めない。reqmixは全non-completeをhitにする\",\n        \"status\": \"SOL-PROTOCOL-001\"\n      },\n      {\n        \"area\": \"two-hit・near-limit・速いarm\",\n        \"coverage\": \"独立した静的反例で1秒armの3・4巡目欠落を確認\",\n        \"status\": \"SOL-PROTOCOL-002。測定結果ではない\"\n      },\n      {\n        \"area\": \"中断後の終了・quiet truth\",\n        \"coverage\": \"接続close、KILL要求、到着数保存とDB終了確認を分離して検査\",\n        \"status\": \"SOL-PROTOCOL-003\"\n      },\n      {\n        \"area\": \"到着数・打切りlatency\",\n        \"coverage\": \"scheduled=completed+failed+inflight+queuedの保存、dispatch待ちを含むlatency\",\n        \"status\": \"静的に支持。未完了をSLO合格へ使わない\"\n      },\n      {\n        \"area\": \"control・再校正\",\n        \"coverage\": \"scaleは前後順序と期間対応を記録。reqmix05〜08にno-count controlなし\",\n        \"status\": \"条件付き診断に限定。因果的増分・cache同等性は未立証\"\n      },\n      {\n        \"area\": \"index・MVCC・更新形\",\n        \"coverage\": \"indexedのsplit_kは負例、uniformでは不変キー。統計サイズ、HLL等を記録\",\n        \"status\": \"内部COUNT索引や普遍的順位は断定不可\"\n      },\n      {\n        \"area\": \"raw・source・artifact・cache\",\n        \"coverage\": \"固定source SHA、raw保存検証コード、成果物SHA、入力fingerprint、再利用条件を査読\",\n        \"status\": \"現在実行の成果物整合とsemantic auditは保留\"\n      },\n      {\n        \"area\": \"退役プロトコル\",\n        \"coverage\": \"3e\/3fと05〜08の仮説対応、保存source\/status\/logのハッシュ\",\n        \"status\": \"置換方針を支持。退役を実験成功とは扱わない\"\n      }\n    ],\n    \"priorityFixes\": [\n      {\n        \"priority\": 1,\n        \"findingId\": \"SOL-PROTOCOL-001\",\n        \"action\": \"予定上限を明示的に認定し、予期しないエラーと原因不明をtwo-hitから除外してsemantic failureへ伝播する。\"\n      },\n      {\n        \"priority\": 2,\n        \"findingId\": \"SOL-PROTOCOL-002\",\n        \"action\": \"予定機会すべての結果・省略理由と比較成立条件を定義し、予算不足を成功終了にしない。必要比較の予算を分割する。\"\n      },\n      {\n        \"priority\": 3,\n        \"findingId\": \"SOL-PROTOCOL-003\",\n        \"action\": \"中断後のサーバー終了確認と負荷停止のfinallyを追加する。未確認の後続窓・quiet truthは主張から除外する。\"\n      }\n    ]\n  }\n}","updatedAt":"2026-11-07T05:36:07Z","usage":{"inputTokens":1659709,"outputTokens":17105,"providerRaw":{},"totalTokens":1676814}}],"instanceConfiguration":{},"instanceIdentity":"default","instanceKind":"default","reviewFindings":[],"rootSessionId":"temp-table-count-protocol-sol-session-15","sessionId":"temp-table-count-protocol-sol-session-15","status":"completed","updatedAt":"2026-11-07T05:36:07Z","workflowId":"temp-table-count-protocol-sol"},"status":"completed","transitions":0,"workflowId":"temp-table-count-protocol-sol"},"type":"run_result"}

es\": 0,\n      \"assessment\": \"Every raw target-buffer proof precedes its COUNT and reports cached=0\/dirty=0. B\/C\/D use CHECKPOINT then DBCC; A verifies clean pages without assuming writable CHECKPOINT. Plan cache remains retained; OS\/VM\/macOS caches are uncontrolled.\"\n    },\n    \"precisionVsObservedD\": \"All results match the static fixture. D is explicitly observed_rows, with no accuracy-under-writes or start-time snapshot guarantee. Actual metadata confirms 100 stored columns and no fixture RLS predicates.\",\n    \"release\": {\n      \"verifiedRecords\": 27,\n      \"mismatches\": 0,\n      \"assessment\": \"Reviewed 18 after-sample, six after-dispose and three smoke release records. Request, snapshot and transaction absence are checked against the owned identity; disposed sessions and locks disappear. Monitoring does not hide changed DB\/isolation through restrictive joins.\"\n    },\n    \"cleanup\": {\n      \"clientExitCode\": 0,\n      \"primaryExitCode\": 0,\n      \"secondaryExitCode\": 0,\n      \"controllerExitCode\": 1,\n      \"assessment\": \"Actual terminal logs show setup=0 sql=0 on both nodes; no timeout or forced process termination occurred. Nonce resources and guarded host stage were removed. Raw controller status remains incomplete with its immediate capacity failure.\",\n      \"laterCapacityAssessment\": \"The later observation binds the unchanged raw run and canonical invocation, retains the same 1 GiB criterion, and records only 270692352 bytes below pre-run free capacity. This establishes later capacity recovery separately from resource absence; it does not certify block erasure or global cache purging.\"\n    },\n    \"limitations\": [\n      \"Unsupported Rosetta diagnostic environment; no native performance or product ranking inference.\",\n      \"Fixed order, cache residuals, compilation, host IO\/thermal context and different active-instance counts prevent causal isolation of DB-state effects.\",\n      \"Quiet static fixture; service budget remains UNAVAILABLE.\",\n      \"No generalization to TDE, LOB, compression or arbitrary 100-column tables.\",\n      \"Historical SQL2025 failures remain failures and are not combined with SQL2022 samples.\",\n      \"Acceptance covers the documented measurement and cleanup evidence, not a controller-exit-0 claim.\"\n    ]\n  },\n  \"reviewEvidence\": {\n    \"hashVerification\": {\n      \"protectedFiles\": 11046,\n      \"currentSourceAndDocumentBindings\": 37,\n      \"runtimeArtifacts\": 2842,\n      \"finalArchiveFiles\": 2843,\n      \"historicalArchiveFiles\": 4758,\n      \"commandLogBindings\": 1448,\n      \"mismatches\": 0,\n      \"method\": \"Read-only foreground Python standard-library verification, followed by direct caller, SQL, raw sample, receipt, release and lifecycle inspection.\"\n    },\n    \"bindings\": [\n      {\n        \"path\": \"results\/reviews\/sqlserver-manual-count-100m\/owner-proof.json\",\n        \"sha256\": \"b7d5507c656310a52507b2249a954a5266f9aed1ab1c74df8d844310743bb898\"\n      },\n      {\n        \"path\": \"results\/reviews\/sqlserver-manual-count-100m\/owner-audit.json\",\n        \"sha256\": \"eca6291c61c6377eacdef2f44e0bd7dbba4566f8acb2b5cfc3e3ca8937405d02\"\n      },\n      {\n        \"path\": \"results\/reviews\/sqlserver-manual-count-100m\/baseline.json\",\n        \"sha256\": \"4512052b06b5776a99183e2b29b1d5783df59c865aeb3acfd0156b967f43d427\"\n      },\n      {\n        \"path\": \"sqlserver\/manual-count-100m\/manual\/sql-server.md\",\n        \"sha256\": \"9a66b40420396c8481d55b68de3781fe3712993beaeca9f711e6ba0605922682\"\n      },\n      {\n        \"path\": \"results\/sqlserver\/manual-count-100m\/runs\/20261108T234303Z-7e3f51b7e5a312af1e695029bd48dcb5\/result.json\",\n        \"sha256\": \"3a304239d5d5be1382060c218d593739be01a3ae3d24bdfebcab3b259e738d26\"\n      },\n      {\n        \"path\": \"results\/reference\/sqlserver-manual-count-100m-20261108T234303Z-7e3f51b7e5a312af1e695029b
rrors.Add(new { phase=\"monitor_identity_idle\",type=e.GetType().Name,e.Message });\n        } finally {\n            async Task Close(SqlConnection c,Identity? expected,string name,string flag) {\n                try {\n                    await c.DisposeAsync().AsTask().WaitAsync(TimeSpan.FromSeconds(15));\n                    if(expected!=null) {\n                        await Release(expected,cell,true,name);\n                        smoke[flag]=true;\n                    }\n                } catch(Exception e) {\n                    errors.Add(new { phase=name,type=e.GetType().Name,e.Message });\n                }\n            }\n            await Close(session,id,\"preload-smoke-session-after-dispose\",\"session_disposed_release_verified\");\n            await Close(admin,adminId,\"preload-smoke-admin-after-dispose\",\"admin_disposed_release_verified\");\n            smoke[\"end_ns\"]=Ns();\n            smoke[\"status\"]=errors.Count==0?\"passed\":\"failed\";\n            smoke[\"accepted\"]=errors.Count==0;\n            Save(\"preload-monitor-smoke.json\",smoke); Persist();\n        }\n        Require(errors.Count==0,\"preload monitor\/identity\/release smoke failed; see preload-monitor-smoke.json\");\n    }\n    static async Task FixtureSetup() {\n","old":"    static async Task FixtureSetup() {\n","path":"sqlserver\/manual-count-100m\/Program.cs"},{"new":"        await PreloadMonitorSmoke();\n        long start=Ns(),committed=0;\n","old":"        long start=Ns(),committed=0;\n","path":"sqlserver\/manual-count-100m\/Program.cs"},{"new":"            string.Join(\", \", Enumerable.Range(4, 96)) + \" FROM seq ORDER BY id OPTION (MAXDOP 1);\\n\" +\n","old":"            string.Join(\", \", Enumerable.Range(4, 96)) + \" FROM seq;\\n\" +\n","path":"sqlserver\/manual-count-100m\/Fixture.cs"},{"new":"    @cleanup_deadline = now + 240\n","old":"    @cleanup_deadline = now + 120\n","path":"sqlserver\/manual-count-100m\/lab.rb"},{"new":"            stop_seconds = name ==
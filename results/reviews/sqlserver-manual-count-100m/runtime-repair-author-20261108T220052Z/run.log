ed. The failed fixture's observed pages do not establish the new fixture's size or AG capacity sufficiency.","COUNT SQL\/hints, plans' observation procedure, cold protocol, six cells\/eighteen slots, count20min\/load2h\/global6h, host70\/index24\/floor12GiB, both nodes'2048MB SQL caps, Rosetta proofs and guarded cleanup remain unchanged."],"shutdown":["Only SQL-server stop grace changes to60 seconds, with a65-second CLI bound; client stop bounds remain20\/25 seconds.","Independent overall cleanup budget becomes240 seconds. Ownership, pinned IDs, terminal-state checks, failure preservation, guest-side guarded unlink and stage-preservation conditions remain intact.","No capacity-reclamation wait, cache purge, restart or threshold relaxation is added. The original within1GiB capacity requirement remains."],"smoke":["Runs after actual empty-table geometry\/settings validation and before starting the two-hour insertion budget.","Exercises actual Guard, immutable identity verification, ObserveSql and Idle(false), followed by independently connected Release checks for the live session and both disposed smoke sessions.","Attempts disposal\/release of both smoke connections even after a smoke failure, persists primary and cleanup errors, and propagates failure before insertion.","Uses no Target COUNT, sample, new condition, context tag or COUNT transaction wrapper. Acceptance additionally requires the persisted successful smoke and all release flags."],"sqlBoundaryAudit":["The first ObserveSql raw string ends at WHERE without a trailing newline. An explicit space before Match fixes the concrete WHEREs token concatenation.","The other four Match joins already end their preceding ordinary strings with a space. Each Match is followed by a semicolon\/newline before the next statement; StateSql therefore has a valid statement boundary.","Fixture.InsertSql joins the numeric offset immediately after CAST( and follows it with a leading-space AS BIGINT fragment. That punctuation boundary is valid and requires no whitespace repair.","No additional concrete concatenation defect was identified in the inspected Program.cs, Fixture.cs and State.cs SQL construction."]},"replacements":[{"new":"        \"\"\"+\" \"+Match+\";\\n\"+\n","old":"        \"\"\"+Match+\";\\n\"+\n","path":"sqlserver\/manual-count-100m\/Program.cs"},{"new":"        [\"primary_state_observations\"]=PrimaryStates,\n        [\"preload_monitor_smoke\"]=new { status=\"pending\",accepted=false },\n","old":"        [\"primary_state_observations\"]=PrimaryStates,\n","path":"sqlserver\/manual-count-100m\/Program.cs"},{"new":"    static async Task PreloadMonitorSmoke() {\n        var cell=Fixture.Cells[0];\n        var observations=new List<Observation>();\n        var errors=new List<object>();\n        var smoke=new Dictionary<string,object?> {\n            [\"status\"]=\"running\", [\"accepted\"]=false, [\"start_ns\"]=Ns(),\n            [\"scope\"]=\"new_empty_100_column_fixture_before_first_insert\",\n            [\"before_load\"]=false, [\"open_session_release_verified\"]=false,\n            [\"session_disposed_release_verified\"]=false, [\"admin_disposed_release_verified\"]=false,\n            [\"sql\"]=ObserveSql, [\"observations\"]=observations, [\"errors\"]=errors\n        };\n        Probe[\"preload_monitor_smoke\"]=smoke; Persist();\n        using var session=Connection(); using var admin=Connection();\n        Identity? id=null,adminId=null;\n        try {\n            Require(Receipts.Count==0,\"preload smoke must precede every fixture INSERT\");\n            smoke[\"before_load\"]=true;\n            await Open(session,Total.Token);\n            id=await Guard(session,\"preload-smoke-session\",cell);\n            smoke[\"session_identity\"]=id;\n            await Open(admin,Total.Token);\n            adminId=await Guard(admin,\"preload-smoke-admin\",cell);\n            smoke[\"admin_identity\"]=adminId;\n            Require(id.Spid!=adminId.Spid && id.ConnectionId!=adminId.ConnectionId,\n                \"preload smoke requires independent dedicated connections\");\n            var seen=await Observe(admin,id,cell,Total.Token); observations.Add(seen);\n            Require(seen.Sets[0].Count==1 && seen.Sets[0][0][\"connection_id\"] is Guid physical &&\n                physical==id.ConnectionId && Idle(seen,false),\n                \"preload monitor did not identify the idle live session\");\n            await Guard(session,\"preload-smoke-immutable-identity\",cell,id);\n            await Release(id,cell,false,\"preload-smoke-open-session\");\n            smoke[\"open_session_release_verified\"]=true;\n        } catch(Exception e) {\n            errors.Add(new { phase=\"monitor_identity_idle\",type=e.GetType().Name,e.Message });\n        } finally {\n            async Task Close(SqlConnection c,Identity? expected,string name,string flag) {\n                try {\n                    await c.DisposeAsync().AsTask().WaitAsync(TimeSpan.FromSeconds(15));\n                    if(expected!=null) {\n                        await Release(expected,cell,true,name);\n                        smoke[flag]=true;\n                    }\n                } catch(Exception e) {\n                    errors.Add(new { phase=name,type=e.GetType().Name,e.Message });\n                }\n            }\n            await Close(session,id,\"preload-smoke-session-after-dispose\",\"session_disposed_release_verified\");\n            await Close(admin,adminId,\"preload-smoke-admin-after-dispose\",\"admin_disposed_release_verified\");\n            smoke[\"end_ns\"]=Ns();\n            smoke[\"status\"]=errors.Count==0?\"passed\":\"failed\";\n            smoke[\"accepted\"]=errors.Count==0;\n            Save(\"preload-monitor-smoke.json\",smoke); Persist();\n        }\n        Require(errors.Count==0,\"preload monitor\/identity\/release smoke failed; see preload-monitor-smoke.json\");\n    }\n    static async Task FixtureSetup() {\n","old":"    static async Task FixtureSe
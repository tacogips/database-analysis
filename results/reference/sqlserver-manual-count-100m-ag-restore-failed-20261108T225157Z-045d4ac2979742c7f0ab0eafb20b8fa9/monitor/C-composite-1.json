  "sql": "SELECT s.session_id,s.login_time,s.login_name,DB_NAME(s.database_id) db_name,s.transaction_isolation_level,s.open_transaction_count,\n  (SELECT c.connection_id FROM sys.dm_exec_connections c WHERE c.session_id=s.session_id AND c.parent_connection_id IS NULL) connection_id\nFROM sys.dm_exec_sessions s WHERE s.session_id=@sid AND s.login_time=@login_time AND s.login_name=@login\nAND @@SERVERNAME=@server;\nSELECT r.* FROM sys.dm_exec_requests r JOIN sys.dm_exec_sessions s ON r.session_id=s.session_id WHERE s.session_id=@sid AND s.login_time=@login_time AND s.login_name=@login\nAND @@SERVERNAME=@server;\nSELECT l.* FROM sys.dm_tran_locks l JOIN sys.dm_exec_sessions s ON l.request_session_id=s.session_id WHERE s.session_id=@sid AND s.login_time=@login_time AND s.login_name=@login\nAND @@SERVERNAME=@server;\nSELECT x.* FROM sys.dm_tran_active_snapshot_database_transactions x JOIN sys.dm_exec_sessions s ON x.session_id=s.session_id WHERE s.session_id=@sid AND s.login_time=@login_time AND s.login_name=@login\nAND @@SERVERNAME=@server;\nSELECT x.*, a.transaction_begin_time,a.transaction_state FROM sys.dm_tran_session_transactions x JOIN sys.dm_exec_sessions s ON x.session_id=s.session_id LEFT JOIN sys.dm_tran_active_transactions a ON a.transaction_id=x.transaction_id WHERE s.session_id=@sid AND s.login_time=@login_time AND s.login_name=@login\nAND @@SERVERNAME=@server;\nSELECT d.name,CONVERT(int,d.is_read_committed_snapshot_on) is_read_committed_snapshot_on,d.snapshot_isolation_state,d.snapshot_isolation_state_desc,\n  CONVERT(int,sys.fn_hadr_is_primary_replica(d.name)) is_ag_primary,\n  SERVERPROPERTY(\u0027IsHadrEnabled\u0027) is_hadr_enabled,@@SERVERNAME server_name,\n  rs.role_desc,ar.secondary_role_allow_connections_desc,rs.connected_state_desc,\n  ds.synchronization_state_desc,ds.synchronization_health_desc,ds.is_suspended,\n  ds.redo_queue_size,ds.last_redone_lsn,ds.last_hardened_lsn,ds.last_commit_time,\n  (SELECT COUNT(*) FROM sys.dm_exec_requests r JOIN sys.dm_exec_sessions s ON s.session_id=r.session_id\n   WHERE s.is_user_process=1 AND r.database_id=d.database_id AND r.command IN\n     (\u0027INSERT\u0027,\u0027UPDATE\u0027,\u0027DELETE\u0027,\u0027MERGE\u0027,\u0027BULK INSERT\u0027,\u0027SELECT INTO\u0027)) active_user_writes\nFROM sys.databases d\nLEFT JOIN sys.dm_hadr_database_replica_states ds ON ds.database_id=d.database_id AND ds.is_local=1\nLEFT JOIN sys.dm_hadr_availability_replica_states rs ON rs.replica_id=ds.replica_id AND rs.group_id=ds.group_id AND rs.is_local=1\nLEFT JOIN sys.availability_replicas ar ON ar.replica_id=ds.replica_id\nWHERE d.database_id=DB_ID();",

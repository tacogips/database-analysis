        "Path": "/bin/bash",
        "Args": [
            "-c",
            "# Keep INT effective for asynchronously started children; signal PIDs, never groups.\nset -m\nsql_pid=\nsetup_pid=\nsignal_epoch=0\nterm_pending=0\nint_pending=0\nforward_signal() {\n  local sig=\"$1\" child\n  for child in \"$sql_pid\" \"$setup_pid\"; do\n    if [[ -n \"$child\" ]]; then\n      kill -s \"$sig\" -- \"$child\" 2>/dev/null || :\n    fi\n  done\n}\non_signal() {\n  signal_epoch=$((signal_epoch + 1))\n  case \"$1\" in\n    TERM) term_pending=1 ;;\n    INT) int_pending=1 ;;\n  esac\n  forward_signal \"$1\"\n}\nreplay_signals() {\n  if (( term_pending )); then kill -s TERM -- \"$1\" 2>/dev/null || :; fi\n  if (( int_pending )); then kill -s INT -- \"$1\" 2>/dev/null || :; fi\n}\nwait_child() {\n  local target=\"$1\" epoch rc\n  while :; do\n    epoch=$signal_epoch\n    wait -f \"$target\"\n    rc=$?\n    # A trapped signal interrupts wait; retry the SAME child for its actual status.\n    if (( epoch == signal_epoch )); then return \"$rc\"; fi\n  done\n}\ntrap 'on_signal TERM' TERM\ntrap 'on_signal INT' INT\nif [[ ! -x /opt/mssql/bin/permissions_check.sh ]]; then\n  echo 'Unable to run startup permissions check, exiting.' >&2\n  exit 1\nfi\n/opt/mssql/bin/permissions_check.sh\nstartup_status=$?\nif (( startup_status != 0 )); then exit \"$startup_status\"; fi\ncase \"${MSSQL_PID,,}\" in\n  standarddeveloper) export MSSQL_PID=DeveloperStandard ;;\n  enterprisedeveloper) export MSSQL_PID=Developer ;;\nesac\nsource /opt/mssql/bin/init_custom_setup.sh\nstartup_status=$?\nif (( startup_status != 0 )); then exit \"$startup_status\"; fi\nif (( term_pending )); then exit 143; fi\nif (( int_pending )); then exit 130; fi\n/opt/mssql/bin/sqlservr &\nsql_pid=$!\n# Replay signals received between launch and capture of the owned child PID.\nreplay_signals \"$sql_pid\"\nsetup_status=0\nif (( !term_pending && !int_pending )); then\n  /opt/mssql/bin/run_custom_setup.sh &\n  setup_pid=$!\n  replay_signals \"$setup_pid\"\n  wait_child \"$setup_pid\"\n  setup_status=$?\n  setup_pid=\nfi\nif (( setup_status != 0 )); then\n  # Failed startup must not abandon the SQL child it already started.\n  kill -s TERM -- \"$sql_pid\" 2>/dev/null || :\nfi\nwait_child \"$sql_pid\"\nsql_status=$?\nsql_pid=\nprintf 'manual100m entrypoint terminal: setup=%s sql=%s\\n' \"$setup_status\" \"$sql_status\"\nif (( sql_status != 0 )); then exit \"$sql_status\"; fi\nif (( setup_status != 0 )); then exit \"$setup_status\"; fi\nexit \"$sql_status\"\n"
        ],

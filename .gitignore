# Generated by `mise run prepare`; never commit table data or dumps.
.data/
# Riela runtime state. Workflow definitions stay tracked.
.riela/*
!.riela/workflows/
# Logs from a run. Measurement results are kept as evidence for the guideline.
results/*.log
__pycache__/
*.pyc
.DS_Store
# Local handover notes
.private.handover/

# Advisory lock for this repository's lab runner.
.lab.lock
